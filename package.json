{
  "name": "vanguard-academy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.tsx\"",
    "smoke": "vite build --ssr tests/smoke.tsx --outDir .smoke --logLevel warn && node .smoke/smoke.js",
    "test:dom": "vite build --ssr tests/interaction.tsx --outDir .smoke/dom --logLevel warn && node .smoke/dom/interaction.js",
    "test": "npm run smoke && npm run test:dom",
    "check": "tsc -b && npm run lint && npm run format:check && npm run test && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Vanguard Academy \u2014 public portal + management system prototype (React, Vite, Tailwind, Framer Motion, Recharts)"
}
